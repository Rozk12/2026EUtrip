# Basic Auth (both required to enable). If unset, the site is public.
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Google Sheets (optional). Both required to enable the Sheet data source.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Gemini API (for /kamera — ask-about-photo feature). Get a free key at
# https://aistudio.google.com/app/apikey . Gemini 2.0 Flash free tier is
# plenty for trip use (15 req/min, 1M tokens/day).
GEMINI_API_KEY=
